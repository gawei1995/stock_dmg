{
  "name": "trading-cockpit-desktop",
  "version": "0.24.13",
  "private": true,
  "description": "Local-first TradingView + Longbridge + trading agent cockpit",
  "author": "Gawei",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "electron .",
    "test": "node --test tests/*.test.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "pack": "node scripts/verify-release.mjs --target dir",
    "dist:mac": "node scripts/verify-release.mjs --target mac"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@stoqey/ib": "1.6.10"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.gawei.tradingcockpit",
    "productName": "交易驾驶舱",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "renderer/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../trading-agent-workspace/.agents/skills",
        "to": "trading-agent-skills",
        "filter": [
          "review-decision-cycles/**/*",
          "review-earnings-decisions/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "交易驾驶舱 ${version}"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
